    "first_run.demo.instant.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Explore Sure’s live demo account: where the money came from, where it went, and how this month compares."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Explora la cuenta de demostración de Sure: de dónde vino el dinero, en qué se gastó y cómo se compara este mes."
          }
        }
      }
    },
    "first_run.demo.instant.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A real month of money, made clear."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un mes real de finanzas, explicado con claridad."
          }
        }
      }
    },
