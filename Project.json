{
  "configs" : {
    "Debug" : "debug",
    "Release" : "release"
  },
  "name" : "Sure",
  "options" : {
    "deploymentTarget" : {
      "iOS" : "18.0",
      "macOS" : "15.0",
      "watchOS" : "11.0"
    },
    "groupSortPosition" : "bottom",
    "transitivelyLinkDependencies" : false
  },
  "targets" : {
    "Sure" : {
      "entitlements" : {
        "path" : "App\/App.entitlements",
        "properties" : {
          "aps-environment" : "$(APS_ENVIRONMENT)",
          "com.apple.security.app-sandbox" : true,
          "com.apple.security.network.client" : true,
          "com.apple.security.network.server" : true
        }
      },
      "info" : {
        "path" : "App\/Info.plist",
        "properties" : {
          "CFBundleDisplayName" : "Sure",
          "CFBundleShortVersionString" : "0.7.4",
          "CFBundleVersion" : "1",
          "ITSAppUsesNonExemptEncryption" : false,
          "LSApplicationCategoryType" : "public.app-category.finance",
          "UILaunchScreen" : {

          },
          "UISupportedInterfaceOrientations" : [
            "UIInterfaceOrientationPortrait",
            "UIInterfaceOrientationPortraitUpsideDown",
            "UIInterfaceOrientationLandscapeLeft",
            "UIInterfaceOrientationLandscapeRight"
          ]
        }
      },
      "platform" : "auto",
      "scheme" : {
        "coverageTargets" : [
          "Sure"
        ],
        "gatherCoverageData" : true,
        "testTargets" : [
          "SureTests"
        ]
      },
      "settings" : {
        "base" : {
          "APS_ENVIRONMENT" : "development",
          "ASSETCATALOG_COMPILER_APPICON_NAME" : "AppIcon",
          "ASSETCATALOG_COMPILER_GLOBAL_ACCENT_COLOR_NAME" : "AccentColor",
          "CURRENT_PROJECT_VERSION" : "1",
          "MARKETING_VERSION" : "0.7.4",
          "PRODUCT_BUNDLE_IDENTIFIER" : "am.sure.insights",
          "PRODUCT_NAME" : "$(TARGET_NAME)",
          "SWIFT_VERSION" : "5.0",
          "TARGETED_DEVICE_FAMILY" : "1,2"
        },
        "configs" : {
          "Release" : {
            "APS_ENVIRONMENT" : "production",
            "CODE_SIGN_IDENTITY" : "Apple Distribution",
            "CODE_SIGN_STYLE" : "Automatic"
          }
        }
      },
      "sources" : [
        {
          "path" : "App"
        },
        {
          "path" : "Shared"
        }
      ],
      "supportedDestinations" : [
        "iOS",
        "macOS"
      ],
      "type" : "application"
    },
    "SureTests" : {
      "dependencies" : [
        {
          "target" : "Sure"
        }
      ],
      "platform" : "iOS",
      "settings" : {
        "base" : {
          "SWIFT_VERSION" : "5.0"
        }
      },
      "sources" : [
        {
          "path" : "Tests\/SureTests"
        }
      ],
      "type" : "bundle.unit-test"
    },
    "Sure Watch" : {
      "info" : {
        "path" : "Watch\/Info.plist",
        "properties" : {
          "CFBundleDisplayName" : "Sure",
          "CFBundleShortVersionString" : "0.7.4",
          "CFBundleVersion" : "1",
          "ITSAppUsesNonExemptEncryption" : false,
          "WKApplication" : true,
          "WKCompanionAppBundleIdentifier" : "am.sure.insights"
        }
      },
      "platform" : "watchOS",
      "settings" : {
        "base" : {
          "ASSETCATALOG_COMPILER_APPICON_NAME" : "AppIcon",
          "ASSETCATALOG_COMPILER_GLOBAL_ACCENT_COLOR_NAME" : "AccentColor",
          "CURRENT_PROJECT_VERSION" : "1",
          "MARKETING_VERSION" : "0.7.4",
          "PRODUCT_BUNDLE_IDENTIFIER" : "am.sure.insights.watchkitapp",
          "PRODUCT_NAME" : "$(TARGET_NAME)",
          "SWIFT_VERSION" : "5.0"
        },
        "configs" : {
          "Release" : {
            "CODE_SIGN_IDENTITY" : "Apple Distribution",
            "CODE_SIGN_STYLE" : "Automatic"
          }
        }
      },
      "sources" : [
        {
          "path" : "Watch"
        },
        {
          "path" : "Shared"
        },
        {
          "path" : "App\/Assets.xcassets"
        }
      ],
      "type" : "application"
    }
  }
}
