{
  "configs" : {
    "Debug" : "debug",
    "Release" : "release"
  },
  "name" : "Sure",
  "options" : {
    "deploymentTarget" : {
      "iOS" : "18.0",
      "macOS" : "15.0",
      "watchOS" : "11.0"
    },
    "groupSortPosition" : "bottom",
    "transitivelyLinkDependencies" : false
  },
  "packages" : {
    "PostHog" : {
      "url" : "https://github.com/PostHog/posthog-ios.git",
      "exactVersion" : "3.59.3"
    }
  },
  "targets" : {
    "Sure" : {
      "dependencies" : [
        {
          "package" : "PostHog",
          "destinationFilters" : ["iOS"]
        },
        {
          "destinationFilters" : [
            "iOS"
          ],
          "embed" : true,
          "target" : "Sure Watch"
        },
        {
          "destinationFilters" : [
            "iOS"
          ],
          "embed" : true,
          "target" : "Sure FinanceKit Background"
        }
      ],
      "info" : {
        "path" : "App\/Info.plist",
        "properties" : {
          "SurePostHogProjectToken" : "$(SURE_POSTHOG_PROJECT_TOKEN)",
          "SurePostHogHost" : "$(SURE_POSTHOG_HOST)",
          "SureFinanceKitKeychainAccessGroup" : "$(AppIdentifierPrefix)am.sure.insights.financekit",
          "CFBundleDisplayName" : "Sure",
          "CFBundleShortVersionString" : "0.7.4",
          "CFBundleURLTypes" : [
            {
              "CFBundleTypeRole" : "Editor",
              "CFBundleURLName" : "am.sure.insights.oauth",
              "CFBundleURLSchemes" : [
                "sureapp"
              ]
            }
          ],
          "CFBundleVersion" : "1",
          "ITSAppUsesNonExemptEncryption" : false,
          "NSFinancialDataUsageDescription" : "Sure uses financial data from Wallet for the on-device account preview and, only when you separately enable it, to sync selected accounts and transactions to your Sure family.",
          "LSApplicationCategoryType" : "public.app-category.finance",
          "UILaunchScreen" : {

          },
          "UISupportedInterfaceOrientations" : [
            "UIInterfaceOrientationPortrait",
            "UIInterfaceOrientationPortraitUpsideDown",
            "UIInterfaceOrientationLandscapeLeft",
            "UIInterfaceOrientationLandscapeRight"
          ]
        }
      },
      "platform" : "auto",
      "scheme" : {
        "coverageTargets" : [
          "Sure"
        ],
        "gatherCoverageData" : true,
        "testTargets" : [
          "SureTests"
        ]
      },
      "settings" : {
        "base" : {
          "SURE_POSTHOG_PROJECT_TOKEN" : "phc_nzFRH9Z5MxehHFJ3Bq38EtA6Bkgqy7mM4TBjQuRr3rJQ",
          "SURE_POSTHOG_HOST" : "https://us.i.posthog.com",
          "ASSETCATALOG_COMPILER_APPICON_NAME" : "AppIcon",
          "ASSETCATALOG_COMPILER_GLOBAL_ACCENT_COLOR_NAME" : "AccentColor",
          "CODE_SIGN_ENTITLEMENTS[sdk=iphoneos*]" : "App\/iOS.entitlements",
          "CODE_SIGN_ENTITLEMENTS[sdk=iphonesimulator*]" : "App\/iOS.entitlements",
          "CODE_SIGN_ENTITLEMENTS[sdk=macosx*]" : "App\/macOS.entitlements",
          "SWIFT_ACTIVE_COMPILATION_CONDITIONS[sdk=iphoneos*]" : "$(inherited) FINANCEKIT_ENABLED",
          "SWIFT_ACTIVE_COMPILATION_CONDITIONS[sdk=iphonesimulator*]" : "$(inherited) FINANCEKIT_ENABLED",
          "CURRENT_PROJECT_VERSION" : "1",
          "MARKETING_VERSION" : "0.7.4",
          "PRODUCT_BUNDLE_IDENTIFIER" : "am.sure.insights",
          "PRODUCT_NAME" : "$(TARGET_NAME)",
          "SWIFT_VERSION" : "5.0",
          "TARGETED_DEVICE_FAMILY" : "1,2"
        },
        "configs" : {
          "Release" : {
            "CODE_SIGN_STYLE" : "Automatic"
          }
        }
      },
      "sources" : [
        {
          "path" : "App"
        },
        {
          "path" : "Shared"
        }
      ],
      "supportedDestinations" : [
        "iOS",
        "macOS"
      ],
      "type" : "application"
    },
    "Sure FinanceKit Background" : {
      "type" : "extensionkit-extension",
      "platform" : "iOS",
      "supportedDestinations" : [
        "iOS"
      ],
      "info" : {
        "path" : "FinanceKitBackground\/Info.plist",
        "properties" : {
          "CFBundleDisplayName" : "Sure Finance Sync",
          "CFBundleShortVersionString" : "0.7.4",
          "CFBundleVersion" : "1",
          "EXAppExtensionAttributes" : {
            "EXExtensionPointIdentifier" : "com.apple.financekit.background-delivery"
          },
          "ITSAppUsesNonExemptEncryption" : false,
          "SureFinanceKitKeychainAccessGroup" : "$(AppIdentifierPrefix)am.sure.insights.financekit"
        }
      },
      "settings" : {
        "base" : {
          "APPLICATION_EXTENSION_API_ONLY" : "YES",
          "CODE_SIGN_ENTITLEMENTS" : "FinanceKitBackground\/FinanceKitBackground.entitlements",
          "CURRENT_PROJECT_VERSION" : "1",
          "IPHONEOS_DEPLOYMENT_TARGET" : "26.0",
          "MARKETING_VERSION" : "0.7.4",
          "PRODUCT_BUNDLE_IDENTIFIER" : "am.sure.insights.financekit-background",
          "PRODUCT_NAME" : "$(TARGET_NAME)",
          "SKIP_INSTALL" : "YES",
          "SWIFT_ACTIVE_COMPILATION_CONDITIONS" : "$(inherited) FINANCEKIT_ENABLED",
          "SWIFT_VERSION" : "5.0"
        },
        "configs" : {
          "Release" : {
            "CODE_SIGN_STYLE" : "Automatic"
          }
        }
      },
      "sources" : [
        {
          "path" : "FinanceKitBackground"
        },
        {
          "path" : "App\/Domain\/FinanceKitSync"
        },
        {
          "path" : "App\/Domain\/Subscriptions\/BackendAccessGate.swift"
        },
        {
          "path" : "App\/Domain\/Subscriptions\/SubscriptionProductIDs.swift"
        },
        {
          "path" : "App\/Infrastructure\/API\/Core\/HTTPDataTransport.swift"
        },
        {
          "path" : "App\/Infrastructure\/Purchases\/SubscriptionHTTPDataTransport.swift"
        },
        {
          "path" : "App\/Infrastructure\/FinanceKit\/Publishing"
        }
      ]
    },
    "SureTests" : {
      "dependencies" : [
        {
          "target" : "Sure"
        }
      ],
      "platform" : "auto",
      "settings" : {
        "base" : {
          "BUNDLE_LOADER" : "$(TEST_HOST)",
          "SWIFT_VERSION" : "5.0",
          "TEST_HOST[sdk=iphoneos*]" : "$(BUILT_PRODUCTS_DIR)\/Sure.app\/Sure",
          "TEST_HOST[sdk=iphonesimulator*]" : "$(BUILT_PRODUCTS_DIR)\/Sure.app\/Sure",
          "TEST_HOST[sdk=macosx*]" : "$(BUILT_PRODUCTS_DIR)\/Sure.app\/Contents\/MacOS\/Sure"
        }
      },
      "sources" : [
        {
          "path" : "Tests\/SureTests"
        }
      ],
      "supportedDestinations" : [
        "iOS",
        "macOS"
      ],
      "type" : "bundle.unit-test"
    },
    "Sure Watch" : {
      "info" : {
        "path" : "Watch\/Info.plist",
        "properties" : {
          "CFBundleDisplayName" : "Sure",
          "CFBundleShortVersionString" : "0.7.4",
          "CFBundleVersion" : "1",
          "ITSAppUsesNonExemptEncryption" : false,
          "WKApplication" : true,
          "WKCompanionAppBundleIdentifier" : "am.sure.insights"
        }
      },
      "platform" : "watchOS",
      "scheme" : {
        "coverageTargets" : [
          "Sure Watch"
        ],
        "gatherCoverageData" : true,
        "testTargets" : [
          "Sure WatchTests"
        ]
      },
      "settings" : {
        "base" : {
          "ASSETCATALOG_COMPILER_APPICON_NAME" : "AppIcon",
          "ASSETCATALOG_COMPILER_GLOBAL_ACCENT_COLOR_NAME" : "AccentColor",
          "CURRENT_PROJECT_VERSION" : "1",
          "MARKETING_VERSION" : "0.7.4",
          "PRODUCT_BUNDLE_IDENTIFIER" : "am.sure.insights.watchkitapp",
          "PRODUCT_NAME" : "$(TARGET_NAME)",
          "SWIFT_VERSION" : "5.0"
        },
        "configs" : {
          "Release" : {
            "CODE_SIGN_STYLE" : "Automatic"
          }
        }
      },
      "sources" : [
        {
          "path" : "Watch"
        },
        {
          "path" : "Shared"
        },
        {
          "path" : "App\/Assets.xcassets"
        }
      ],
      "type" : "application"
    },
    "Sure WatchTests" : {
      "dependencies" : [
        {
          "target" : "Sure Watch"
        }
      ],
      "platform" : "watchOS",
      "settings" : {
        "base" : {
          "SWIFT_VERSION" : "5.0"
        }
      },
      "sources" : [
        {
          "path" : "Tests\/SureWatchTests"
        }
      ],
      "type" : "bundle.unit-test"
    },
    "Sure UI Host": {
      "type": "application",
      "platform": "iOS",
      "sources": [
        {
          "path": "App",
          "excludes": [
            "Application/AppDefinition.swift",
            "Info.plist"
          ]
        },
        {
          "path": "Shared"
        },
        {
          "path": "Tests/SureUITestHost"
        }
      ],
      "dependencies": [
        {
          "package": "PostHog"
        }
      ],
      "settings": {
        "base": {
          "PRODUCT_BUNDLE_IDENTIFIER": "am.sure.uitest-host",
          "SWIFT_ACTIVE_COMPILATION_CONDITIONS": "$(inherited) FINANCEKIT_ENABLED",
          "GENERATE_INFOPLIST_FILE": "YES",
          "SWIFT_VERSION": "5.0",
          "TARGETED_DEVICE_FAMILY": "1,2",
          "INFOPLIST_KEY_UILaunchScreen_Generation": "YES"
        }
      },
      "scheme": {
        "testTargets": [
          "Sure UI Tests"
        ]
      }
    },
    "Sure UI Tests": {
      "type": "bundle.ui-testing",
      "platform": "iOS",
      "sources": [
        {
          "path": "Tests/SureUITests"
        }
      ],
      "dependencies": [
        {
          "target": "Sure UI Host"
        }
      ],
      "settings": {
        "base": {
          "TEST_TARGET_NAME": "Sure UI Host",
          "SWIFT_VERSION": "5.0",
          "GENERATE_INFOPLIST_FILE": "YES"
        }
      }
    }
  }
}
